# PostgreSQL
DATABASE_URL=postgresql://novra:novra@localhost:5432/novra

# Secure session signing (generate at least 32 random bytes)
AUTH_SECRET=replace-with-a-long-random-secret

# Transactional email (Resend-compatible HTTP API)
EMAIL_FROM=Novra <hello@example.com>
EMAIL_TO=hello@example.com
EMAIL_PROVIDER_API_KEY=

# Optional AI consultation
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-mini

