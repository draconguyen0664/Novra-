generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  ADMIN
}

enum InquiryStatus {
  NEW
  CONTACTED
  QUALIFIED
  CLOSED
  SPAM
}

model User {
  id           String   @id @default(cuid())
  name         String
  email        String   @unique
  passwordHash String
  role         UserRole @default(ADMIN)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model ContactInquiry {
  id                     String        @id @default(cuid())
  name                   String
  phone                  String
  company                String?
  email                  String
  services               String[]
  budget                 String
  details                String
  preferredContactMethod String?
  locale                 String
  status                 InquiryStatus @default(NEW)
  source                 String        @default("website")
  createdAt              DateTime      @default(now())
  updatedAt              DateTime      @updatedAt

  @@index([status, createdAt])
  @@index([email])
}

model ProjectInquiry {
  id        String        @id @default(cuid())
  name      String
  email     String
  phone     String?
  service   String?
  message   String
  locale    String
  status    InquiryStatus @default(NEW)
  source    String        @default("website")
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt
}

model NewsletterSubscriber {
  id        String   @id @default(cuid())
  email     String   @unique
  locale    String
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Service {
  id            String   @id @default(cuid())
  slugVi        String   @unique
  slugEn        String   @unique
  nameVi        String
  nameEn        String
  descriptionVi String
  descriptionEn String
  contentVi     String
  contentEn     String
  icon          String?
  sortOrder     Int      @default(0)
  published     Boolean  @default(false)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model Project {
  id            String   @id @default(cuid())
  slugVi        String   @unique
  slugEn        String   @unique
  titleVi       String
  titleEn       String
  descriptionVi String
  descriptionEn String
  category      String
  coverImage    String
  gallery       String[]
  client        String?
  year          Int?
  projectUrl    String?
  featured      Boolean  @default(false)
  sortOrder     Int      @default(0)
  published     Boolean  @default(false)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model Category {
  id        String     @id @default(cuid())
  slug      String     @unique
  nameVi    String
  nameEn    String
  posts     BlogPost[]
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
}

model BlogPost {
  id               String    @id @default(cuid())
  slugVi           String    @unique
  slugEn           String    @unique
  titleVi          String
  titleEn          String
  excerptVi        String
  excerptEn        String
  contentVi        String
  contentEn        String
  coverImage       String
  categoryId       String?
  category         Category? @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  seoTitleVi       String?
  seoTitleEn       String?
  seoDescriptionVi String?
  seoDescriptionEn String?
  published        Boolean   @default(false)
  publishedAt      DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  @@index([published, publishedAt])
}

model PricingPlan {
  id            String   @id @default(cuid())
  key           String   @unique
  nameVi        String
  nameEn        String
  labelVi       String
  labelEn       String
  priceFrom     Int
  originalPrice Int?
  currency      String   @default("VND")
  durationVi    String
  durationEn    String
  descriptionVi String
  descriptionEn String
  featuresVi    String[]
  featuresEn    String[]
  recommended   Boolean  @default(false)
  sortOrder     Int      @default(0)
  published     Boolean  @default(false)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model FAQ {
  id         String   @id @default(cuid())
  questionVi String
  questionEn String
  answerVi   String
  answerEn   String
  sortOrder  Int      @default(0)
  published  Boolean  @default(false)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

model SiteSetting {
  id            String   @id @default("primary")
  companyName   String
  phone         String
  email         String
  zalo          String?
  facebook      String?
  address       String?
  defaultLocale String   @default("vi")
  seoDefaults   Json?
  socialLinks   Json?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model AuditLog {
  id         String   @id @default(cuid())
  userId     String?
  action     String
  resource   String
  resourceId String?
  metadata   Json?
  createdAt  DateTime @default(now())

  @@index([resource, createdAt])
}
