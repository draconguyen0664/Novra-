generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  ADMIN
  SUPER_ADMIN
  EDITOR
  MARKETING
}

enum ContentStatus {
  DRAFT
  PUBLISHED
  SCHEDULED
}

enum AiMessageRole {
  USER
  ASSISTANT
  SYSTEM
}

enum InquiryStatus {
  NEW
  CONTACTED
  QUALIFIED
  PROPOSAL_SENT
  WON
  LOST
  CLOSED
  SPAM
}

model User {
  id           String     @id @default(cuid())
  name         String
  email        String     @unique
  passwordHash String
  role         UserRole   @default(ADMIN)
  active       Boolean    @default(true)
  posts        BlogPost[]
  leadNotes    LeadNote[]
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
}

model ContactInquiry {
  id                     String           @id @default(cuid())
  name                   String
  phone                  String
  company                String?
  email                  String
  services               String[]
  budget                 String
  details                String
  preferredContactMethod String?
  locale                 String
  status                 InquiryStatus    @default(NEW)
  source                 String           @default("website")
  createdAt              DateTime         @default(now())
  updatedAt              DateTime         @updatedAt
  notes                  LeadNote[]
  aiConversations        AiConversation[]

  @@index([status, createdAt])
  @@index([email])
}

model ProjectInquiry {
  id        String        @id @default(cuid())
  name      String
  email     String
  phone     String?
  service   String?
  message   String
  locale    String
  status    InquiryStatus @default(NEW)
  source    String        @default("website")
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt
}

model NewsletterSubscriber {
  id        String   @id @default(cuid())
  email     String   @unique
  locale    String
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Service {
  id               String   @id @default(cuid())
  slugVi           String   @unique
  slugEn           String   @unique
  nameVi           String
  nameEn           String
  descriptionVi    String
  descriptionEn    String
  contentVi        String
  contentEn        String
  icon             String?
  coverImage       String?
  featured         Boolean  @default(false)
  seoTitleVi       String?
  seoTitleEn       String?
  seoDescriptionVi String?
  seoDescriptionEn String?
  sortOrder        Int      @default(0)
  published        Boolean  @default(false)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
}

model Project {
  id               String            @id @default(cuid())
  slugVi           String            @unique
  slugEn           String            @unique
  titleVi          String
  titleEn          String
  descriptionVi    String
  descriptionEn    String
  category         String
  industry         String?
  coverImage       String
  gallery          String[]
  images           ProjectImage[]
  heroCards        HeroProjectCard[]
  client           String?
  year             Int?
  projectUrl       String?
  challengeVi      String?
  challengeEn      String?
  solutionVi       String?
  solutionEn       String?
  resultsVi        String?
  resultsEn        String?
  services         String[]          @default([])
  technologies     String[]          @default([])
  showOnHomepage   Boolean           @default(false)
  seoTitleVi       String?
  seoTitleEn       String?
  seoDescriptionVi String?
  seoDescriptionEn String?
  featured         Boolean           @default(false)
  sortOrder        Int               @default(0)
  published        Boolean           @default(false)
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
}

model Category {
  id        String     @id @default(cuid())
  slug      String     @unique
  nameVi    String
  nameEn    String
  posts     BlogPost[]
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
}

model Tag {
  id        String     @id @default(cuid())
  slug      String     @unique
  nameVi    String
  nameEn    String
  posts     BlogPost[]
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
}

model BlogPost {
  id               String        @id @default(cuid())
  slugVi           String        @unique
  slugEn           String        @unique
  titleVi          String
  titleEn          String
  excerptVi        String
  excerptEn        String
  contentVi        String
  contentEn        String
  coverImage       String
  categoryId       String?
  category         Category?     @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  tags             Tag[]
  authorId         String?
  author           User?         @relation(fields: [authorId], references: [id], onDelete: SetNull)
  seoTitleVi       String?
  seoTitleEn       String?
  seoDescriptionVi String?
  seoDescriptionEn String?
  published        Boolean       @default(false)
  status           ContentStatus @default(DRAFT)
  scheduledAt      DateTime?
  ogImage          String?
  publishedAt      DateTime?
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt

  @@index([published, publishedAt])
}

model PricingPlan {
  id            String           @id @default(cuid())
  key           String           @unique
  nameVi        String
  nameEn        String
  labelVi       String
  labelEn       String
  priceFrom     Int?
  originalPrice Int?
  currency      String           @default("VND")
  durationVi    String
  durationEn    String
  descriptionVi String
  descriptionEn String
  bestForVi      String?
  bestForEn      String?
  ctaVi          String?
  ctaEn          String?
  featuresVi    String[]
  featuresEn    String[]
  recommended   Boolean          @default(false)
  sortOrder     Int              @default(0)
  published     Boolean          @default(false)
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt
  featureItems  PricingFeature[]
}

model FAQ {
  id         String   @id @default(cuid())
  questionVi String
  questionEn String
  answerVi   String
  answerEn   String
  sortOrder  Int      @default(0)
  published  Boolean  @default(false)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

model SiteSetting {
  id                        String   @id @default("primary")
  companyName               String
  phone                     String
  email                     String
  zalo                      String?
  facebook                  String?
  address                   String?
  logo                      String?
  favicon                   String?
  linkedIn                  String?
  footerContent             Json?
  ga4Id                     String?
  metaPixelId               String?
  searchConsoleVerification String?
  defaultLocale             String   @default("vi")
  seoDefaults               Json?
  socialLinks               Json?
  createdAt                 DateTime @default(now())
  updatedAt                 DateTime @updatedAt
}

model AuditLog {
  id         String   @id @default(cuid())
  userId     String?
  action     String
  resource   String
  resourceId String?
  metadata   Json?
  createdAt  DateTime @default(now())

  @@index([resource, createdAt])
}

model Page {
  id        String        @id @default(cuid())
  key       String        @unique
  name      String
  slugVi    String        @unique
  slugEn    String        @unique
  published Boolean       @default(true)
  sections  PageSection[]
  seo       SeoSetting?
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt
}

model PageSection {
  id        String   @id @default(cuid())
  pageId    String
  page      Page     @relation(fields: [pageId], references: [id], onDelete: Cascade)
  key       String
  name      String
  contentVi Json?
  contentEn Json?
  enabled   Boolean  @default(true)
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([pageId, key])
  @@index([pageId, sortOrder])
}

model HeroProjectCard {
  id        String   @id @default(cuid())
  projectId String?
  project   Project? @relation(fields: [projectId], references: [id], onDelete: SetNull)
  image     String
  link      String?
  visible   Boolean  @default(true)
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model NavigationItem {
  id           String   @id @default(cuid())
  labelVi      String
  labelEn      String
  urlVi        String
  urlEn        String
  visible      Boolean  @default(true)
  openInNewTab Boolean  @default(false)
  sortOrder    Int      @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model LeadNote {
  id        String         @id @default(cuid())
  leadId    String
  lead      ContactInquiry @relation(fields: [leadId], references: [id], onDelete: Cascade)
  authorId  String?
  author    User?          @relation(fields: [authorId], references: [id], onDelete: SetNull)
  content   String
  createdAt DateTime       @default(now())

  @@index([leadId, createdAt])
}

model ProjectImage {
  id        String   @id @default(cuid())
  projectId String
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  url       String
  altVi     String?
  altEn     String?
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
}

model PricingFeature {
  id        String      @id @default(cuid())
  planId    String
  plan      PricingPlan @relation(fields: [planId], references: [id], onDelete: Cascade)
  labelVi   String
  labelEn   String
  sortOrder Int         @default(0)
}

model AiConversation {
  id        String          @id @default(cuid())
  sessionId String          @unique
  locale    String          @default("vi")
  leadId    String?
  lead      ContactInquiry? @relation(fields: [leadId], references: [id], onDelete: SetNull)
  messages  AiMessage[]
  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt

  @@index([createdAt])
}

model AiMessage {
  id             String         @id @default(cuid())
  conversationId String
  conversation   AiConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  role           AiMessageRole
  content        String
  createdAt      DateTime       @default(now())

  @@index([conversationId, createdAt])
}

model Media {
  id        String   @id @default(cuid())
  filename  String
  url       String   @unique
  mimeType  String
  size      Int
  width     Int?
  height    Int?
  altVi     String?
  altEn     String?
  createdAt DateTime @default(now())

  @@index([filename])
}

model SeoSetting {
  id            String   @id @default(cuid())
  pageId        String?  @unique
  page          Page?    @relation(fields: [pageId], references: [id], onDelete: Cascade)
  key           String   @unique
  titleVi       String?
  titleEn       String?
  descriptionVi String?
  descriptionEn String?
  ogImage       String?
  canonicalUrl  String?
  indexable     Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}
